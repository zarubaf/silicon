; CHECK: hw.module @top(
; CHECK: %[[BOUND:.+]] = hw.constant 12 : i4
; CHECK: %[[IN:.+]] = comb.icmp ult %x, %[[BOUND]] : i4
; CHECK: %[[EN:.+]] = comb.and %we, %[[IN]] : i1
; CHECK: %[[ZERO:.+]] = hw.constant 0 : i8
; CHECK: %p = comb.mux %{{.+}}, %[[RD:.+]], %[[ZERO]] : i8
; CHECK: %[[RD]] = hw.instance "m" @silicon_mem_12x8_r1w1(clk: %clk: !seq.clock, r0_addr: %x: i4, w0_addr: %x: i4, w0_data: %d: i8, w0_en: %[[EN]]: i1) -> (r0_data: i8)
; CHECK: hw.module.extern @silicon_mem_12x8_r1w1(in %clk : !seq.clock, in %r0_addr : i4, out r0_data : i8, in %w0_addr : i4, in %w0_data : i8, in %w0_en : i1)
; Depth 12 needs guards. One read port, one write port.
(design top
  (module top
    (input clk clock)
    (input x (bits 4))
    (input d (bits 8))
    (input we (bits 1))
    (output p (bits 8))
    (mem m (bits 8) 12 clk)
    (write m 0 x d we)
    (assign p (read m x))))
