; CHECK: hw.module @counter(in %clk : !seq.clock, in %rst : i1, in %en : i1, out q : i8)
; CHECK: %[[INC:.+]] = comb.add %silicon_reg_r, %{{.+}} : i8
; CHECK: %[[NEXT:.+]] = comb.mux %en, %[[INC]], %silicon_reg_r : i8
; CHECK: %silicon_reg_r = seq.compreg %[[NEXT]], %clk reset %rst, %{{.+}} : i8
; CHECK: hw.output %silicon_reg_r : i8
; The counter of the spec.
(design counter
  (module counter
    (input clk clock)
    (input rst (bits 1))
    (input en (bits 1))
    (output q (bits 8))
    (reg r (bits 8) clk (reset sync rst (const 8 0)))
    (let inc (bits 8) (add r (const 8 1)))
    (next r (mux en inc r))
    (assign q r)))
