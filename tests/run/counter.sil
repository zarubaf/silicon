; The counter of spec 3.1: count, enable off, synchronous reset (spec 5.2).
; The start state is all zero (spec 6.4.3). q shows r before the update.
(design counter
  (module counter
    (input clk clock)
    (input rst (bits 1))
    (input en (bits 1))
    (output q (bits 8))
    (reg r (bits 8) clk (reset sync rst (const 8 0)))
    (let inc (bits 8) (add r (const 8 1)))
    (next r (mux en inc r))
    (assign q r)))
; STEP in=(rst 0 en 1) out=(q 0)
; STEP in=(rst 0 en 1) out=(q 1)
; STEP in=(rst 0 en 0) out=(q 2)
; STEP in=(rst 0 en 1) out=(q 2)
; STEP in=(rst 1 en 1) out=(q 3)
; reset wins over enable: r = 0
; STEP in=(rst 0 en 0) out=(q 0)
