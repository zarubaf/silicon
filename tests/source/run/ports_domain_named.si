// The domain of a port is the name in the `domains(d)` clause of the child.
// TOP M()
module C() domains(d) {
    input a: Bool;
    output q: Bool;
    reg r: Bool = false;
    r := a;
    q := r;
}
module M() domains(d) {
    input x: Bool;
    output o: Bool;
    instance u = C();
    u.a := x;
    let ps = @ports(u);
    static_assert(ps[0].domain == "d", "the input");
    static_assert(ps[1].domain == "d", "the output");
    o := u.q;
}
// STEP in=(d$0rst true x false) out=(o false)
// STEP in=(d$0rst false x true) out=(o false)
// STEP in=(d$0rst false x false) out=(o true)
