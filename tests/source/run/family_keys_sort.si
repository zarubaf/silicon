// The keys 2 and 10 sort as numbers, so `req[2]` comes before `req[10]`, and the same holds for the outputs. The vectors use this order.
// TOP M()
module M() {
    input req[10]: UInt[4];
    input req[2]: UInt[4];
    output gnt[10]: UInt[4];
    output gnt[2]: UInt[4];
    gnt[10] := req[10];
    gnt[2] := req[2];
}
// STEP in=(clock$0rst false req[2] 1 req[10] 2) out=(gnt[2] 1 gnt[10] 2)
// STEP in=(clock$0rst false req[2] 15 req[10] 0) out=(gnt[2] 15 gnt[10] 0)
