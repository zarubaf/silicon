// An entry of the empty type is a port with no leaf, so it adds nothing to the vectors.
// TOP M()
module M() {
    output o: UInt[4];
    input req[0]: ();
    input req[1]: UInt[4];
    o := req[1];
}
// STEP in=(clock$0rst false req[1] 6) out=(o 6)
// STEP in=(clock$0rst false req[1] 9) out=(o 9)
