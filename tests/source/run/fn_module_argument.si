// A function as a module argument: the top instantiates one child twice, with two functions of the same type. Each function runs on hardware, so the child applies it in its body.
// TOP Top()
fn inc(x: UInt[8]) -> UInt[8] {
    return x +% 1;
}
fn dbl(x: UInt[8]) -> UInt[8] {
    return x +% x;
}
module Apply(comptime f: fn (UInt[8]) -> UInt[8]) domains() {
    input a: UInt[8];
    output q: UInt[8];
    q := f(a);
}
module Top() domains() {
    input x: UInt[8];
    output p: UInt[8];
    output q: UInt[8];
    instance first = Apply(inc);
    instance second = Apply(dbl);
    first.a := x;
    second.a := x;
    p := first.q;
    q := second.q;
}
// STEP in=(x 0) out=(p 1 q 0)
// STEP in=(x 5) out=(p 6 q 10)
// STEP in=(x 200) out=(p 201 q 144)
// STEP in=(x 255) out=(p 0 q 254)
