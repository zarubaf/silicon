// A temporary array of instances gives the instance by its position.
// TOP M()
module C() domains() {
    input a: UInt[4];
    output sum: UInt[4];
    sum := a +% 1;
}

module M() domains() {
    input x: UInt[4];
    output o: UInt[4];
    instance u = C();
    instance v = C();
    u.a := x;
    v.a := x +% 5;
    o := @field([u, v], 1).sum;
}
// STEP in=(x 3) out=(o 9)
// STEP in=(x 12) out=(o 2)
