// An input of a child gives its handle type `Input[P]`.
// TOP M()
type BU = (Bool, UInt[4]);
struct P {
    a: UInt[8],
    b: BU,
}
module C() domains() {
    input a: P;
    output q: P;
    q := a;
}
module M() domains() {
    input x: UInt[8];
    output o: UInt[8];
    instance u = C();
    static_assert(@TypeOf(u.a) == Input[P], "the child input");
    u.a := P(x, (true, 1));
    o := u.q.a;
}
// STEP in=(x 3) out=(o 3)
// STEP in=(x 250) out=(o 250)
