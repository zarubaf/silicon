// `@typeInfo(SInt[5])` gives the kind `sint` and the width 5. Only the default fields stay: no fields, the element `Unit`, the length 0, and no variants.
// TOP M()
module M() domains() {
    input x: UInt[8];
    output o: UInt[8];
    static_assert(@typeInfo(SInt[5]) == TypeInfo("sint", list(FieldInfo), Unit, 0, 5, list(VariantInfo)), "sint");
    o := x;
}
// STEP in=(x 3) out=(o 3)
// STEP in=(x 250) out=(o 250)
