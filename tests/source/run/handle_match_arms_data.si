// Row "an arm of a hardware `match`" of the frontend spec, section 9.2. The arm position is `data`, so the registers in
// the arms read as data, as in `handle_if_arms_data`.
// TOP M()
module M() {
    input k: UInt[1];
    input x: UInt[8];
    output p: UInt[8];
    output q: UInt[8];
    reg r: UInt[8] = 0;
    reg s: UInt[8] = 0;
    r := x;
    s := x +% 1;
    let v = match (k) {
        0 => [r, s],
        _ => [s, r],
    };
    p := v[0];
    q := v[1];
}
// STEP in=(clock$0rst true k 0 x 0) out=(p 0 q 0)
// STEP in=(clock$0rst false k 0 x 4) out=(p 0 q 0)
// STEP in=(clock$0rst false k 0 x 9) out=(p 4 q 5)
// STEP in=(clock$0rst false k 1 x 9) out=(p 10 q 9)
