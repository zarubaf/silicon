// `@typeInfo` of a generated record type has the kind `record`, its fields in order, and the length. The width stays 0.
// TOP M()
module M() domains() {
    input x: UInt[8];
    output o: UInt[8];
    let mut fs = list(FieldInfo);
    push(fs, FieldInfo("a", UInt[8]));
    push(fs, FieldInfo("b", Bool));
    static_assert(@typeInfo(@Struct(fs)) == TypeInfo("record", fs, Unit, 2, 0, list(VariantInfo)), "record");
    o := x;
}
// STEP in=(x 3) out=(o 3)
// STEP in=(x 250) out=(o 250)
