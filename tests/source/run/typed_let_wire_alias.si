// Row "a `let` with a handle type" of the frontend spec, section 9.2. An alias of a wire binds the wire
// and reads it in the same cycle.
// TOP M()
module M() domains() {
    input x: UInt[8];
    output o: UInt[8];
    wire w: UInt[8];
    let a: Wire[UInt[8]] = w;
    a := x +% 2;
    o := read(a);
}
// STEP in=(x 1) out=(o 3)
// STEP in=(x 254) out=(o 0)