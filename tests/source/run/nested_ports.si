// A record with an array and a tuple, as an input and an output port. The leaves follow the
// packing order of the fields.
// TOP M()
struct Inner {
    s: [UInt[2]; 2],
    f: Bool,
}
struct Outer {
    n: UInt[3],
    i: Inner,
    t: (Bool, UInt[2]),
}
module M() domains() {
    input p: Outer;
    output q: Outer;
    q := Outer(p.n +% 1, Inner([p.i.s[1], p.i.s[0]], p.t.0), (p.i.f, p.t.1));
}
// STEP in=(p.n 1 p.i.s.0 2 p.i.s.1 3 p.i.f true p.t.0 false p.t.1 1) out=(q.n 2 q.i.s.0 3 q.i.s.1 2 q.i.f false q.t.0 true q.t.1 1)
// STEP in=(p.n 7 p.i.s.0 0 p.i.s.1 1 p.i.f false p.t.0 true p.t.1 3) out=(q.n 0 q.i.s.0 1 q.i.s.1 0 q.i.f true q.t.0 false q.t.1 3)
