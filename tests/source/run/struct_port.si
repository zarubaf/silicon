// A generated record type as a port type: each field is one leaf of the port.
// TOP M()
type G = @Struct([FieldInfo("a", UInt[4]), FieldInfo("b", Bool)]);
module M() domains() {
    input p: G;
    output q: G;
    q := G(p.a +% 1, p.b);
}
// STEP in=(p.a 3 p.b true) out=(q.a 4 q.b true)
// STEP in=(p.a 15 p.b false) out=(q.a 0 q.b false)
