// Row "a `let` with a handle type" of the frontend spec, section 9.2. `let a: Reg[UInt[8]] = r;`
// keeps the handle, so `a := x;` binds `r` through the alias.
// TOP M()
module M() {
    input x: UInt[8];
    output o: UInt[8];
    reg r: UInt[8] = 0;
    let a: Reg[UInt[8]] = r;
    a := x;
    o := r;
}
// STEP in=(clock$0rst true x 0) out=(o 0)
// STEP in=(clock$0rst false x 4) out=(o 0)
// STEP in=(clock$0rst false x 5) out=(o 4)