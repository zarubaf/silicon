// An `@field` step in a query selects like `.a`.
// TOP M()
struct P {
    a: UInt[8],
    b: BU,
}
type BU = (Bool, UInt[4]);
module M() domains() {
    input p: P;
    output o: UInt[8];
    static_assert(@TypeOf(@field(p, "a")) == UInt[8], "a record");
    static_assert(@TypeOf(@field(p.b, 1)) == UInt[4], "a tuple");
    o := p.a;
}
// STEP in=(p.a 3 p.b.0 true p.b.1 1) out=(o 3)
// STEP in=(p.a 250 p.b.0 false p.b.1 2) out=(o 250)
