// The target `p.a := e` selects a field of a record of registers. A field of a handle type is a handle, so the target is the
// register of the field.
// TOP M()
struct P {
    a: Reg[UInt[8]],
    b: Reg[UInt[8]],
}
module M() {
    input x: UInt[8];
    output o: UInt[8];
    output q: UInt[8];
    reg r: UInt[8] = 0;
    reg s: UInt[8] = 0;
    let p = P(r, s);
    p.a := x;
    p.b := x +% 1;
    o := r;
    q := s;
}
// STEP in=(clock$0rst true x 0) out=(o 0 q 0)
// STEP in=(clock$0rst false x 4) out=(o 0 q 0)
// STEP in=(clock$0rst false x 9) out=(o 4 q 5)
