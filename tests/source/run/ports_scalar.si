// `@ports(u)` gives one `PortInfo` for each port of the child, the inputs first. The key of a scalar port is not indexed. The type is the data type, also for an input.
// TOP M()
module C() {
    input a: UInt[4];
    output q: Bool;
    q := a == 3;
}
module M() {
    input x: UInt[4];
    output o: Bool;
    instance u = C();
    u.a := x;
    let ps = @ports(u);
    static_assert(len(ps) == 2, "two ports");
    static_assert(ps[0] == PortInfo(PortKey("a", false, 0), UInt[4], true, "clock"), "the input");
    static_assert(ps[1] == PortInfo(PortKey("q", false, 0), Bool, false, "clock"), "the output");
    o := u.q;
}
// STEP in=(clock$0rst false x 3) out=(o true)
// STEP in=(clock$0rst false x 4) out=(o false)
