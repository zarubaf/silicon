// A scalar `PortKey` selects a scalar port: its index is 0.
// TOP M()
module C() domains() {
    input a: UInt[4];
    output sum: UInt[4];
    sum := a +% 1;
}

module M() domains() {
    input x: UInt[4];
    output o: UInt[4];
    instance u = C();
    u.a := x;
    o := @field(u, PortKey("sum", false, 0));
}
// STEP in=(x 3) out=(o 4)
// STEP in=(x 12) out=(o 13)
