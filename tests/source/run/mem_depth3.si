// A depth that is not a power of 2: depth 3 has the address width 2, and address 3 is out of range
// (v0.1 section 5, frontend spec 7.6).
// Inputs: ra, re, wa, wd, we. Outputs: data, valid.
// TOP M()
module M() {
    input ra: UInt[2];
    input re: Bool;
    input wa: UInt[2];
    input wd: UInt[8];
    input we: Bool;
    output data: UInt[8];
    output valid: Bool;
    mem m: [UInt[8]; 3];
    let r = m.read_port(ra, re);
    write_port(m, wa, wd, we);
    data := r.data;
    valid := r.valid;
}
// word 2 takes 4
// STEP in=(clock$0rst false ra 0 re false wa 2 wd 4 we true) out=(data 0 valid false)
// read address 3 (out of range) and write 9 to it
// STEP in=(clock$0rst false ra 3 re true wa 3 wd 9 we true) out=(data 0 valid false)
// read word 2
// STEP in=(clock$0rst false ra 2 re true wa 0 wd 0 we false) out=(data 0 valid false)
// read word 0 and write 5 to word 1 in one cycle; word 0 is still 0
// STEP in=(clock$0rst false ra 0 re true wa 1 wd 5 we true) out=(data 4 valid true)
// STEP in=(clock$0rst false ra 1 re true wa 0 wd 0 we false) out=(data 0 valid true)
// STEP in=(clock$0rst false ra 3 re false wa 0 wd 0 we false) out=(data 5 valid true)
