// A typed use of a hardware array port: the reference checks by its type in one step and charges
// the size of its type. The fuel equal to the total of `cost` succeeds, and one unit less gives
// `S015`.
// FUEL 10087
// TOP M()
module M() domains() {
    input p: [UInt[8]; 1000];
    output y: UInt[8];
    let q: [UInt[8]; 1000] = p;
    y := q[7];
}
