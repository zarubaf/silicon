// The cost of a read whose index pushes into or pops from a list part of the root it waits at
// (section 5.4). The read keeps the list as it was before the index: the pushes and pops change
// the live list in place, and the elements and the length that the read finds are the old ones.
// The charges are those of the changes, and the size of the result as the last step of each read.
// The root is not copied. The fuel equal to the total of `cost` succeeds, and one unit less gives
// `S015`.
// FUEL 265
// TOP M()
module M() domains() {
    input a: UInt[8];
    output y: UInt[8];
    let mut t = (a, list(Nat));
    t.1.push(10);
    t.1.push(20);
    t.1.push(30);
    let v0 = t[(t.1.push(1), 1).1][0];
    let v1 = t[(t.1.pop(), t.1.pop(), 1).2][1];
    let v2 = t[(t.1.pop(), t.1.push(7), t.1.push(8), 1).3][1];
    let v3 = t[(t.1.push(7), t.1.pop(), t.1.pop(), t.1.pop(), 1).4][0];
    y := UInt[8](v0 + v1 + v2 + v3);
}
