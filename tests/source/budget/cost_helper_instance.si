// A child that a helper makes costs the statement, the arguments, and the name to the caller instantiation, and the child pays its own body. The fuel equal to the total of `cost` succeeds, and one unit less gives `S015`.
// FUEL 223
// TOP M()
module C(comptime K: UInt[8]) domains() {
    input a: UInt[8];
    output q: UInt[8];
    q := a +% K;
}
fn spawn(x: UInt[8]) -> UInt[8] {
    instance u = C(8);
    u.a := x;
    return u.q;
}
module M() domains() {
    input x: UInt[8];
    output o: UInt[8];
    o := spawn(x);
}
