// Asymmetric stages in nested tuples: `(h, (3, z)) == (h, (3, x))` compares `3` with `3` statically
// and `z` with `x` in hardware. The fuel equal to the total of `cost` succeeds, and one unit less
// gives `S015`.
// FUEL 124
// TOP M()
module M() domains() {
    input h: Bool;
    input x: UInt[8];
    output e: Bool;
    let z: UInt[8] = 5;
    e := (h, (3, z)) == (h, (3, x));
}
