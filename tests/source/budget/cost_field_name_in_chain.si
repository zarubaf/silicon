// `@field` charges the name of a step after two index steps once, at its own step: it charges 2 for the name `"b"`. The fuel equal to the total of `cost` succeeds, and one unit less gives `S015`.
// FUEL 243
// TOP M()
struct P {
    a: UInt[4],
    b: (Bool, UInt[4]),
}
module M() domains() {
    input x: UInt[4];
    output o: UInt[4];
    let s = (x, P(1, (true, 3)), [P(2, (true, 4)), P(3, (false, 5))]);
    let t = @field(@field(@field(s, 2), 1), "b"); o := t.1;
}
