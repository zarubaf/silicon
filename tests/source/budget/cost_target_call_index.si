// A `:=` target through two nested arrays with a call in its second index. The call records a diagnostic after the first step selected. The fuel equal to the total of `cost` succeeds, and one unit less gives `S015`.
// FUEL 235
// TOP M()
fn idx() -> Nat {
    diagnostic("idx", 0);
    return 0;
}
module M() {
    input x: UInt[8];
    output o: Bool;
    reg r: UInt[8] = 0;
    let a = [[r, r], [r, r]];
    a[1][idx()] := x;
    o := true;
}
