// `T()` charges its node and the recursive size of the zero, which the type metadata gives without a walk. Eight zeros of
// a struct with an array field pay eight times the same size.
// FUEL 287
// TOP M()
struct P {
    a: [UInt[8]; 16],
    b: (Bool, UInt[4]),
}
module M() domains() {
    type A = P;
    comptime for i in 0..8 {
        let z = A();
    }
}
