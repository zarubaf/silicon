// The cost of a read whose indices rebind the root (section 5.4). Lean decides if an index holds
// the root from the part as the read found it before the earlier index, not from the root after
// that index. The first `g(t)` rebinds `t` to static parts, but the part of the read was
// hardware when it waited, so the second index holds nothing and its `g(t)` charges no size of `t`.
// The fuel equal to the total of `cost` succeeds, and one unit less gives `S015`.
// FUEL 514
// TOP M()
fn g(mut t: ([[UInt[8]; 2]; 2], Int)) -> Int {
    t = ([[UInt[8](1), UInt[8](2)], [UInt[8](3), UInt[8](4)]], 5);
    return 0;
}
module M() domains() {
    input a: UInt[8];
    input b: UInt[8];
    input c: UInt[8];
    input d: UInt[8];
    output y: UInt[8];
    let mut t = ([[a, b], [c, d]], 5);
    let k = t.0[g(t)][g(t)];
    y := k;
}
