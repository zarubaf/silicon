// `@field` charges the size of a name after the earlier step of its base, and before the look-up of the name. The name `"b"` of a field charges 2 after an index and a field. The fuel equal to the total of `cost` succeeds, and one unit less gives `S015`.
// FUEL 235
// TOP M()
struct P {
    a: UInt[4],
    b: (Bool, UInt[4]),
}
module M() domains() {
    input x: UInt[4];
    output o: UInt[4];
    let s = (x, P(1, (true, 3)), [P(2, (true, 4)), P(3, (false, 5))]);
    o := @field(@field(s, 1), "b").1;
}
