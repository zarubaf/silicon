// A shared hierarchy: identical instances share one module, so `cost` lists 31
// instantiations and the total stays linear in the depth.
// FUEL 4612
// TOP M(30)
module M(comptime d: Nat) domains() {
    input a: UInt[1];
    output q: UInt[1];
    comptime if (d == 0) {
        q := a;
    } else {
        instance l = M(d - 1);
        instance r = M(d - 1);
        l.a := a;
        r.a := l.q;
        q := r.q;
    }
}
