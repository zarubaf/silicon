// The cost of reads whose indices change lists inside a list part (section 5.4). A push into
// `t.1[0]` and a pop of `t.1` are two changes of the log with paths one inside the other. A read
// of the old element, of the old list, and of a part below it each finds the value from before
// the index. Each such read charges the size of that value at its last step.
// The fuel equal to the total of `cost` succeeds, and one unit less gives `S015`.
// FUEL 342
// TOP M()
module M() domains() {
    input a: UInt[8];
    output y: UInt[8];
    let mut t = (a, list(List[Nat]));
    let mut u = list(Nat);
    u.push(1);
    u.push(2);
    u.push(3);
    t.1.push(u);
    u.push(4);
    t.1.push(u);
    let v0 = t[(t.1[0].push(50), t.1.pop(), 1).2][0][1];
    t.1.push(u);
    let v1 = t[(t.1.pop(), t.1[0].pop(), 1).2][0][2];
    t.1.push(u);
    let v2 = t[(t.1[1].push(51), t.1.pop(), t.1.push(u), 1).3][1][3];
    y := UInt[8](v0 + v1 + v2);
}
