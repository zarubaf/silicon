// The cost of reads whose indices push into a list part of the root (section 5.4). The first
// index of a read changes `t`, so the read ends there: it charges the size of its result, and
// the result is a new value that holds no local. The second index reads that new value, so its
// change of `t` charges no size of `t`.
// The fuel equal to the total of `cost` succeeds, and one unit less gives `S015`.
// FUEL 295
// TOP M()
module M() domains() {
    input x: UInt[8];
    output y: UInt[8];
    let mut t: (UInt[8], [UInt[8]; 2], List[Nat]) = (x, [UInt[8](1), UInt[8](2)], list(Nat));
    t.2.push(10);
    t.2.push(20);
    t[(t.2.push(1), 1).1][(t.2.push(2), 0).1];
    t[(t.2.pop(), 1).1][(t.2.pop(), 1).1];
    t[(t.2.pop(), t.2.pop(), 1).2][(t.2.push(2), 1).1];
    y := x;
}
