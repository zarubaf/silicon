// `data_bits(T)` charges its node and the size of the width that it copies, so the size of the type does not count. Eight calls
// on a large type cost eight nodes and eight widths.
// FUEL 161
// TOP M()
struct P {
    a: [[UInt[8]; 16]; 16],
    b: (Bool, UInt[4]),
}
module M() domains() {
    type A = P;
    comptime for i in 0..8 {
        let n = data_bits(A);
    }
}
