// A counter with an enable: a register, a hardware if, and a static width.
// TOP Counter(4)
module Counter(comptime W: Nat) {
    input enable: Bool;
    output value: UInt[W];
    output full: Bool;
    reg count: UInt[W] = 0;
    count := if (enable) { count +% 1 } else { count };
    value := count;
    full := count == UInt[W]((1 << W) - 1);
}
