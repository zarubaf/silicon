// S010: a typed use at a tuple type checks each handle position. The second leaf needs a wire, and a register is no wire.
// The text names the type of the leaf and the leaf.
// TOP M()
fn k(p: (Reg[UInt[8]], Wire[UInt[8]])) -> Nat {
    return 1;
}
module M() {
    input x: UInt[8];
    reg r: UInt[8] = 0;
    r := x;
    // expected-error S010 @+2
    // expected-message: expected `Wire[UInt[8]]`, but the value is a handle of `Reg[UInt[8]]`; a handle type takes only a handle of exactly this type, so give such a handle or change the type
    let n = k((r, r));
}
