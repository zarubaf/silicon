// S011: a record with a hardware field is no static module argument.
// TOP M()
struct P { a: Bool }
module C(comptime p: P) {}
module M() {
    input x: Bool;
    let p = P(x);
    // expected-error S011 @+2
    // expected-message: a static position needs a static value, not a value of `P`; compute the value from static values, for example from constants and `comptime` parameters
    instance c = C(p);
}
