// S011: the arms of a hardware `match` differ in a static part, here the scalar 1 against 2.
// TOP M()
module M() {
    input x: Bool;
    input h: Bool;
    input a: UInt[4];
    output y: UInt[4];
    // expected-error S011 @+2
    // expected-message: the arms of a hardware `match` differ in a static part: Int and Int
    let p = match (x) { true => (h, 1), false => (h, 2) };
    y := 0;
}
