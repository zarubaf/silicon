// S012: the range check of a key also applies to a `:=` target, here at the first key above the range.
// TOP M()
module M() {
    output gnt[0]: Bool;
    gnt[0] := true;
    // expected-error S012 @+2
    // expected-message: a family key is 0 to 4294967295, not 4294967296; use a key in this range
    gnt[4294967296] := true;
}
