// S003: a struct is a type, not a function, so it is no method.
// TOP M()
struct P {
    a: Bool,
}
module M() {
    let x = true;
    // expected-error S003 @+2
    // expected-message: `P` is not a function; a receiver call `a.f()` needs a function `f`, so write `P(a)` to call a type or a function value
    x.P();
}
