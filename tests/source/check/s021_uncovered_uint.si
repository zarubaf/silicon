// S021: a value that no arm matches. The error is at the `match` keyword.
// TOP M()
module M() {
    input x: UInt[2];
    input a: UInt[4];
    output y: UInt[4];
    // expected-error S021 @+2
    // expected-message: the `match` does not cover `2` of `UInt[2]`; add an arm for it, or add `_ => ...` as the last arm
    y := match (x) { 0 => a, 1 => 2, 3 => 3 };
}
