// S003: a method resolves to a function, and a module is not one.
// TOP M()
module Child() {
}
module M() {
    let x = 1;
    // expected-error S003 @+2
    // expected-message: `Child` is not a function; a receiver call `a.f()` needs a function `f`, so write `Child(a)` to call a type or a function value
    x.Child();
}
