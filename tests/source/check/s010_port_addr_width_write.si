// S010: the address of write_port has another width than the memory address (4 words need UInt[2]).
// TOP M()
module M() {
    input a: UInt[2];
    input e: Bool;
    input d: UInt[8];
    output o: UInt[8];
    input w: UInt[3];
    mem m: [UInt[8]; 4];
    let r = m.read_port(a, e);
    // expected-error S010 @+1
    m.write_port(w, d, e);
    o := r.data;
}
