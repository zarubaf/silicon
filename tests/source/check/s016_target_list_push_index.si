// S016: a `:=` target through a list of lists with an index that pushes onto the root list while it evaluates. The index changes `l`, so it is `S016`.
// TOP M()
fn grow(mut l: List[List[Reg[UInt[8]]]]) -> Nat {
    l.push(list(Reg[UInt[8]]));
    return 0;
}
module M() {
    input x: UInt[8];
    output o: Bool;
    reg r: UInt[8] = 0;
    let mut l = list(List[Reg[UInt[8]]]);
    l.push(list(Reg[UInt[8]]));
    l[0].push(r);
    l[0].push(r);
    // expected-error S016 @+2
    // expected-message: a `:=` target index cannot change `l`; change `l` before the `:=`, keep the result in a `let`, and use that name in the index
    l[grow(l)][1] := x;
    o := true;
}
