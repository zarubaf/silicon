// S016: the key of an `@field` step of a target is an index, so it cannot change a binding.
// TOP M()
module M() {
    input x: UInt[4];
    output o: UInt[4];
    reg r: UInt[4] = 0;
    reg s: UInt[4] = 0;
    let rs = [r, s];
    let mut l = list(Nat);
    push(l, 0);
    // expected-error S016 @+2
    // expected-message: a `:=` target index cannot change `l`; change `l` before the `:=`, keep the result in a `let`, and use that name in the index
    @field(rs, pop(l)) := x;
    r := x;
    s := x;
    o := read(r);
}
