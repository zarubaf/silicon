// S007: a builtin in a type position gives a complete type, so an index after it is an error. Only the first index of a chain reports.
// TOP M()
module M() domains() {
    input x: UInt[8];
    output o: Bool;
    // expected-error S007 @+2
    // expected-message: `@TypeOf(...)` in a type position takes 0 argument(s), but it has 2; the type is complete, so remove the index
    let y: @TypeOf(x)[1, 2][3][4] = x;
    o := true;
}
