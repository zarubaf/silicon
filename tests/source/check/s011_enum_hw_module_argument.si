// S011: a module argument is a static position, so an enum value with a hardware leaf is S011.
// TOP M()
enum Op: UInt[2] { Add = 0, Load(UInt[8]) = 1 }
module C(comptime o: Op) {}
module M() {
    input x: UInt[8];
    let o = Op::Load(x);
    // expected-error S011 @+2
    // expected-message: a static position needs a static value, not a value of `Op`; compute the value from static values, for example from constants and `comptime` parameters
    instance c = C(o);
}
