// S007: a struct specialization has the number of arguments of its declaration.
// TOP M()
struct P(comptime W: Nat) {
    a: UInt[W],
}
module M() domains() {
    // expected-error S007 @+2
    // expected-message: `P` takes 1 argument(s), but it has 2; pass one argument for each `comptime` parameter of `P`
    type A = P[8, 9];
}
