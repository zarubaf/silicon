// S018: a memory with a write_port and no read_port. The error is at the mem statement.
// TOP M()
module M() {
    input a: UInt[2];
    input e: Bool;
    input d: UInt[8];
    output o: UInt[8];
    // expected-error S018 @+2
    // expected-message: the memory `m` has no `read_port`; call `read_port` on it once, or remove the memory
    mem m: [UInt[8]; 4];
    m.write_port(a, d, e);
    o := d;
}
