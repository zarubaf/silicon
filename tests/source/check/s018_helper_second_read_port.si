// S018: a helper reads a memory, and the module calls the helper twice for the memory.
// TOP M()
fn get(m: Mem[UInt[8], 4], a: UInt[2]) -> UInt[8] {
    // expected-error S018 @+2
    // expected-message: the memory `m` has a second `read_port`, because the call in `get` runs again for it; run the call once for each memory, for example with one call of `get` for each
    let r = m.read_port(a, true);
    return r.data;
}
module M() {
    input a: UInt[2];
    input d: UInt[8];
    output o: UInt[8];
    mem m: [UInt[8]; 4];
    write_port(m, a, d, true);
    o := get(m, a) +% get(m, a);
}
