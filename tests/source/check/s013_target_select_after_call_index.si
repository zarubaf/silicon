// S013: the indices of a `:=` target evaluate before the walk selects (section 5.2). The call in the index records its diagnostic, then the selector `.2` of the tuple is out of range.
// OBSERVE: (string "idx") (int 0)
// TOP M()
fn idx() -> Nat {
    diagnostic("idx", 0);
    return 0;
}
module M() {
    input x: UInt[8];
    output o: Bool;
    reg r: UInt[8] = 0;
    let a = ([r], [r]);
    // expected-error S013 @+2
    // expected-message: the selector 2 is out of range for ([Reg[UInt[8]]; 1], [Reg[UInt[8]]; 1])
    a.2[idx()] := x;
    o := true;
