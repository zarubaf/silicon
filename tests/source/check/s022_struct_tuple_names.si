// S022: `@typeInfo` of a tuple type gives the names `0` and `1`. They break the name rule, so `@Struct` of them is S022.
// TOP M()
type T = (UInt[8], Bool);
module M() domains() {
    output o: Bool;
    // expected-error S022 @+2
    // expected-message: `0` is not a valid field name; use an ASCII letter or `_`, then letters, digits, or `_`
    let t = @Struct(@typeInfo(T).fields);
    o := true;
}
