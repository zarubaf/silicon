    a: Bool,
    n: Nat,
}
module M() domains() {
    // expected-error S010 @+2
    // expected-message: `data_bits` needs a hardware data type, not `P`; only a fixed-width type has a bit count, for example `UInt[8]`
    let n = data_bits(P);
}
