// S018: a second write_port of one memory.
// TOP M()
module M() {
    input a: UInt[2];
    input e: Bool;
    input d: UInt[8];
    output o: UInt[8];
    mem m: [UInt[8]; 4];
    let r = read_port(m, a, e);
    write_port(m, a, d, e);
    // expected-error S018 @+2
    // expected-message: the memory `m` has a second `write_port`; the first call is at 10:5; make one call, and select its address, data, and enable with a hardware `if`
    write_port(m, a, d, e);
    o := r.data;
}
