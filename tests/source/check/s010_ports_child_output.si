// S010: A child output `u.q` is no instance. The text names the output.
// TOP M()
module C() {
    input a: UInt[4];
    output q: UInt[4];
    q := a;
}
module M() {
    input x: UInt[4];
    output o: UInt[4];
    instance u = C();
    u.a := x;
    // expected-error S010 @+2
    // expected-message: `@ports` takes an instance handle, not hardware UInt[4]; pass the name of an instance, for example `u` of `instance u = M(...);`
    let t = @ports(u.q);
    o := u.q;
}
