// S011: the index of a `:=` target is static. A hardware index selects no single resource.
// TOP M()
module M() {
    input x: UInt[8];
    input i: UInt[1];
    reg r: UInt[8] = 0;
    reg s: UInt[8] = 0;
    r := x;
    let j = i;
    let rs = [r, s];
    // expected-error S011 @+2
    // expected-message: a static position needs a static value, not a value of `UInt[1]`; compute the value from static values, for example from constants and `comptime` parameters
    rs[j] := x;
}
