// S010: a field of a handle type waits for a later step. The fix is to pass the data value.
// TOP M()
struct P {
    h: Reg[UInt[8]],
}
module M() {
    input x: UInt[8];
    reg r: UInt[8] = 0;
    r := x;
    // expected-error S010 @+2
    // expected-message: the handle type `Reg[UInt[8]]` is not supported here yet; use it in a typed `let`, or pass the data value, for example `read(h)`
    let p = P(r);
}
