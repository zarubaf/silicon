// S019: a public name over the limit of a string in an error message shows in its short form.
// TOP M()
module M() {
    input a: Bool as "aaaaaaaaaabbbbbbbbbbccccccccccddddddddddeeeeeeeeeeffffffffffgggggggggghhhhhhhhhh";
    // expected-error S019 @+2
    // expected-message: the port name `aaaaaaaaaabbbbbbbbbbccccccccccddddddddddeeeeeeeeeeffffffffffgggg... (80 characters)` is declared here and at 4:5; give one of them another key with `as`, for example from a parameter
    input b: Bool as "aaaaaaaaaabbbbbbbbbbccccccccccddddddddddeeeeeeeeeeffffffffffgggggggggghhhhhhhhhh";
}
