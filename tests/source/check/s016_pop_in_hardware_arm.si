// S016: a `pop` in the else arm of a hardware `if` changes a list from before the arm.
// TOP M()
module M() {
    input c: Bool;
    output o: UInt[8];
    let mut xs = list(UInt[8]);
    xs.push(1);
    // expected-error S016 @+2
    // expected-message: a hardware arm cannot change `xs`, a binding from before the arm; change `xs` before the `if` or `match`, and use the result in the arm
    o := if (c) { 3 } else { xs.pop() };
}
