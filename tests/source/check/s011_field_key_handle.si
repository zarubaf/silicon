// S011: a key of `@field` cannot be a handle.
// TOP M()
fn pick(r: Reg[UInt[4]]) -> UInt[4] {
    let a = [1, 2];
    // expected-error S011 @+2
    // expected-message: a key of `@field` holds the register `r`, but it takes only static values; pass the data through a port, or use it in the module that declares it
    return @field(a, r);
}
module M() {
    output o: UInt[4];
    reg r: UInt[4] = 0;
    r := 0;
    o := pick(r);
}
