// S010: a local that holds the output o takes no output entry. The text names the entry by its public name.
// TOP M()
module C() {
  input req[0]: Bool;
}
comptime fn f(x: Bool) -> Nat { return 0; }
module D(comptime b: Bool) {
}
module M() {
  input a: Bool;
  output o: UInt[8];
  output gnt[3]: Bool;
