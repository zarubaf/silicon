// S017: a binding of a child output (v0.1 section 9).
// TOP M()
module C() domains() {
    input a: Bool;
    output q: Bool;
    q := a;
}
module M() domains() {
    output y: Bool;
    instance c = C();
    c.a := false;
    // expected-error S017 @+2
    // expected-message: `q` is an output of the child, not a target; the child drives its outputs, so bind an input of the child
    c.q := true;
    y := c.q;
}
