// S010: the first argument of read_port is an input, not a memory.
// TOP M()
module M() {
    input a: UInt[2];
    input e: Bool;
    input d: UInt[8];
    output o: UInt[8];
    mem m: [UInt[8]; 4];
    // expected-error S010 @+1
    let r = read_port(d, a, e);
    write_port(m, a, d, e);
    o := r.data;
}
