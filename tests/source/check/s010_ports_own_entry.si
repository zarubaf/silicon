// S010: An own family entry is no instance handle either.
// TOP M()
module C() {
    input a: UInt[4];
    output q: UInt[4];
    q := a;
}
module M() {
    input x: UInt[4];
    input req[2]: UInt[4];
    output o: UInt[4];
    instance u = C();
    u.a := x;
    // expected-error S010 @+2
    // expected-message: `@ports` takes an instance handle, not a value of `UInt[4]`; pass the name of an instance, for example `u` of `instance u = M(...);`
    let t = @ports(req[2]);
    o := u.q;
}
