// S013: a read waits at `t` while its index pushes into `t.1`. The list the read finds is the list
// before the push, with 3 elements, so the index 3 is out of range although the list has 4 now.
// TOP M()
module M() domains() {
    input a: UInt[8];
    output y: UInt[8];
    let mut t = (a, list(Nat));
    t.1.push(10);
    t.1.push(20);
    t.1.push(30);
    // expected-error S013 @+2
    // expected-message: the index 3 is out of range for 3 element(s)
    let v = t[(t.1.push(1), 1).1][3];
    y := a;
}
