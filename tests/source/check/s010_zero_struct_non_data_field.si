// S010: `P()` is the zero of a struct, never a constructor, so a field that is not hardware data gives S010.
// TOP M()
struct P {
    a: Int,
}
module M() domains() {
    // expected-error S010 @+2
    // expected-message: a zero `T()` needs a hardware data type, not `P`; write a full value, for example a constructor with one value for each field
    let z = P();
}
