// S010: an empty array of memories has no leaf to report at, but its type holds a memory. The `data` context stops at the
// node, by the handle flag of the type.
// TOP M()
module M() {
    let a: [Mem[UInt[8], 4]; 0] = [];
    // expected-error S010 @+2
    // expected-message: a `data` context does not read `[Mem[UInt[8], 4]; 0]`, a type that holds a memory, an instance, or an input; read the data of each element
    let c = a == a;
}
