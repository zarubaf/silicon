// S011: a `comptime fn` called through a value takes no hardware argument.
// TOP M()
comptime fn inc(x: UInt[8]) -> UInt[8] {
    return x;
}
module M() {
    input x: UInt[8];
    output y: UInt[8];
    let f = inc;
    // expected-error S011 @+2
    // expected-message: a static position needs a static value, not a value of `UInt[8]`; compute the value from static values, for example from constants and `comptime` parameters
    y := f(x);
}
