// S011: a parameter of the type `[Reg[UInt[8]]; 2]` has a type that holds a handle type, so it is no static position
// either. The check reads the handle flag of the type.
// TOP M()
module C(comptime p: [Reg[UInt[8]]; 2]) {
}
module M() {
    // expected-error S011 @+2
