// S015: a loop that copies a large list. Each copy charges the recursive size of the list,
// 10001, so the fuel runs out in the copies, long before the 20000 iterations end.
// TOP M()
module M() {
    let mut big = list(Nat);
    comptime for i in 0..10000 {
        big.push(i);
    }
    comptime for i in 0..20000 {
        // expected-error S015 @+1
        let c = big;
    }
}
