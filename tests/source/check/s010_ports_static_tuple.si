// S010: A static tuple is no instance. The text cuts the type of the tuple, and the check builds no type for it.
// TOP M()
module C() {
    input a: UInt[4];
    output q: UInt[4];
    q := a;
}
module M() {
    input x: UInt[4];
    output o: UInt[4];
    instance u = C();
    u.a := x;
    let tp = (1, 2);
    // expected-error S010 @+2
    // expected-message: `@ports` takes an instance handle, not a value of `(Int, Int)`; pass the name of an instance, for example `u` of `instance u = M(...);`
    let t = @ports(tp);
    o := u.q;
}
