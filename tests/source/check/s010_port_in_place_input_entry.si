// S010: a place cannot select a port of an instance: the input entry. The fix depends on the direction.
// TOP M()
module C() domains() {
    input a[3]: Bool;
    input b: Bool;
    output q: Bool;
    output r[1]: Bool;
    q := true;
    r[1] := true;
}
module M() domains() {
    instance u = C();
    u.a[3] := true;
    u.b := true;
    let mut us = [u];
    // expected-error S010 @+2
    // expected-message: a place cannot select the port `a[3]` of `Instance[C]`; bind the input with a `:=` target, for example `u.a[3] := e`
    us[0].a[3] = true;
}
