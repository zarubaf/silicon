// TOP M()
// OBSERVE-COUNT-1: (string "one")
// OBSERVE-NOT: (string "two")
fn one() -> Nat {
    diagnostic("one", 0);
    return 0;
}
fn two() -> Nat {
    diagnostic("two", 0);
    return 0;
}
fn f() -> Nat {
    let mut m = list(List[Int]);
    m.push(list(Int));
    let y = m[0][one()][5][two()];
    return 0;
}
module M() {
    input x: UInt[8];
    output o: UInt[8];
    let mut l = list(List[Int]);
    l.push(list(Int));
    // expected-error S013 @+1
    let z = l[0][one()][7][f()];
    o := x;
}
