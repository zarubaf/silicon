// S010: The two arms of a hardware `if` join their types. Two handle types join only when they are one type.
// TOP M()
module M() {
    input flag: Bool;
    output o: Bool;
    o := flag;
    // expected-error S010 @+2
    // expected-message: `Reg[Bool]` and `Wire[Bool]` have no common type; a handle type joins only with the same handle type, so give both sides one type
    let q = if (flag) { list(Reg[Bool]) } else { list(Wire[Bool]) };
}
