// S016: a `fn (...) -> R` type expression is a structural context (section 9.4, item 2), so a
// helper with a diagnostic cannot build its width.
// TOP M()
fn note() -> Nat {
    // expected-error S016 @+1
    diagnostic("fn type", 8);
    return 8;
}
fn id(x: UInt[8]) -> UInt[8] {
    return x;
}
module M() {
    let g: fn (UInt[note()]) -> UInt[8] = id;
}
