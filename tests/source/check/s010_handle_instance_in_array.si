// S010: an array literal holds an instance as an element, and `==` reads the array in a `data` context. The instance
// leaf has no data.
// TOP M()
module Leaf() {
    output o: Bool;
    o := true;
}
module M() {
    instance u = Leaf();
    let a = [u, u];
    // expected-error S010 @+2
    // expected-message: `u` is an instance, not data; read its outputs as `u.q`
    let b = a == a;
}
