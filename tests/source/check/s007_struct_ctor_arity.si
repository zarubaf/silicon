// S007: the arity of the constructor of a generated record type is known in pass 5. The type has 2 fields, and the call has 1 argument.
// TOP M()
module M() domains() {
    output o: Bool;
    // expected-error S007 @+2
    // expected-message: a struct constructor takes 0 or 2 argument(s), but it has 1; pass one value for each field, or none for the zero
    let g = @Struct([FieldInfo("a", Bool), FieldInfo("b", Bool)])(true);
    o := g.a;
}
