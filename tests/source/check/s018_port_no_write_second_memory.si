// S018: the second memory has no write_port. The first memory is complete.
// TOP M()
module M() {
    input a: UInt[2];
    input e: Bool;
    input d: UInt[8];
    output o: UInt[8];
    mem m: [UInt[8]; 4];
    let r = m.read_port(a, e);
    m.write_port(a, d, e);
    input b: UInt[1];
    // expected-error S018 @+2
    // expected-message: the memory `n` has no `write_port`; call `write_port` on it once, or remove the memory
    mem n: [UInt[8]; 2];
    let s = n.read_port(b, e);
    o := r.data;
}
