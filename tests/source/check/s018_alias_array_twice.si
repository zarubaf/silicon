// S018: `S018` counts the resource of a target through each alias. Two targets select the register `r` through an array
// and through a name, so `r` has a second binding.
// TOP M()
module M() {
    input x: UInt[8];
    reg r: UInt[8] = 0;
    let rs = [r, r];
    rs[0] := x;
    // expected-error S018 @+2
    // expected-message: `r` has a second binding; the first binding is at 8:5, and the declaration is at 6:5; remove one of the two bindings
    rs[1] := x;
}
