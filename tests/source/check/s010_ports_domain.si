// S010: A domain has no handle and no type, so it is no valid part.
// TOP M()
module C() {
    input a: UInt[4];
    output q: UInt[4];
    q := a;
}
module M() {
    input x: UInt[4];
    output o: UInt[4];
    instance u = C();
    u.a := x;
    // expected-error S010 @+2
    // expected-message: `@ports` takes an instance handle, not the domain `clock`; pass the name of an instance, for example `u` of `instance u = M(...);`
    let t = @ports(clock);
    o := u.q;
}
