// S010: A container of registers has the handle flag, but its elements are no instances. The fix is the default one.
// TOP M()
module C() {
    input a: UInt[4];
    output q: UInt[4];
    q := a;
}
module M() {
    input x: UInt[4];
    output o: UInt[4];
    instance u = C();
    u.a := x;
    reg r1: UInt[4] = 0;
    reg r2: UInt[4] = 0;
    let rs = [r1, r2];
    // expected-error S010 @+2
    // expected-message: `@ports` takes an instance handle, not a value of `[Reg[UInt[4]]; 2]`; pass the name of an instance, for example `u` of `instance u = M(...);`
    let t = @ports(rs);
    r1 := x;
    r2 := x;
    o := u.q;
}
