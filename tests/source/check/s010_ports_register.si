// S010: `@ports` takes an instance handle, so a register is no valid part.
// TOP M()
module C() {
    input a: UInt[4];
    output q: UInt[4];
    q := a;
}
module M() {
    input x: UInt[4];
    output o: UInt[4];
    instance u = C();
    u.a := x;
    reg r: UInt[4] = 0;
    // expected-error S010 @+2
    // expected-message: `@ports` takes an instance handle, not a handle of `Reg[UInt[4]]`; pass the name of an instance, for example `u` of `instance u = M(...);`
    let t = @ports(r);
    r := x;
    o := u.q;
}
