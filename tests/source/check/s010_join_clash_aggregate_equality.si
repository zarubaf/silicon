// S010: `==` with a hardware aggregate joins the types of its operands. Two handle types join only when they are one type.
// TOP M()
module M() {
    input flag: Bool;
    output o: Bool;
    let l: ([Bool; 0], Bool) = ([], flag);
    let t: ([Reg[Bool]; 0], Bool) = ([], true);
    // expected-error S010 @+2
    // expected-message: `Bool` and `Reg[Bool]` have no common type; a handle type joins only with the same handle type, so give both sides one type
    o := l == t;
}
