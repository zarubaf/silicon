// S010: the data of write_port has another type than the word of the memory.
// TOP M()
module M() {
    input a: UInt[2];
    input e: Bool;
    input d: UInt[8];
    output o: UInt[8];
    input b: Bool;
    mem m: [UInt[8]; 4];
    let r = m.read_port(a, e);
    // expected-error S010 @+1
    write_port(m, a, b, e);
    o := r.data;
}
