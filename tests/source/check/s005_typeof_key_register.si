// S005: the key of a query is a static position, so a register there is rejected by the static check.
// TOP M()
module M() {
    output o: Bool;
    reg r: UInt[1] = 0;
    let a = [true, false];
    // expected-error S005 @+2
    // expected-message: `r` is a register; a static position needs a static value
    let t = @TypeOf(a[r]);
    r := 0;
    o := true;
}
