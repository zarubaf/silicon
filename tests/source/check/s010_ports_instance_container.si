// S010: A list of instances is no instance. The fix selects one element.
// TOP M()
module C() {
    input a: UInt[4];
    output q: UInt[4];
    q := a;
}
module M() {
    input x: UInt[4];
    output o: UInt[4];
    instance u = C();
    u.a := x;
    let us = [u];
    // expected-error S010 @+2
    // expected-message: `@ports` takes an instance handle, not a value of `[Instance[C]; 1]`; select one instance, for example `xs[0]`
    let t = @ports(us);
    o := u.q;
}
