// S017: a `:=` target without a step must be a resource. The name is a local that holds a value, so the fix is to assign
// it with `=`.
// TOP M()
module M() {
    let mut a = 1;
    // expected-error S017 @+2
    // expected-message: a `:=` target is a wire, a register, an own output, or a child input, not a value of `Int`; select one of these, or assign a local with `=`
    a := 2;
}
