// S010: A `Type` value of an `Instance` type has no ports. The fix names the handle.
// TOP M()
module C() {
    input a: UInt[4];
    output q: UInt[4];
    q := a;
}
module M() {
    input x: UInt[4];
    output o: UInt[4];
    instance u = C();
    u.a := x;
    let ty = @TypeOf(u);
    // expected-error S010 @+2
    // expected-message: `@ports` takes an instance handle, not a value of `Type`; a type has no ports; pass the handle of `instance u = M(...);`
    let t = @ports(ty);
    o := u.q;
}
