// S021: the smallest uncovered value of SInt[65536] has 65536 bits, so the message gives its bit length.
// TOP M()
module M() {
    input x: SInt[65536];
    input a: UInt[4];
    output y: UInt[4];
    // expected-error S021 @+2
    // expected-message: the `match` does not cover `a negative integer of 65536 bits` of `SInt[65536]`; add an arm for it, or add `_ => ...` as the last arm
    y := match (x) { 0 => a };
}
