// S001: `@ports` takes one operand, not two.
// TOP M()
module C() {
    input a: UInt[4];
    output q: UInt[4];
    q := a;
}
module M() {
    input x: UInt[4];
    output o: UInt[4];
    instance u = C();
    u.a := x;
    // expected-error S001 @+2
    // expected-message: `@ports` takes 1 argument(s), but it has 2; write `@ports(h)`
    let t = @ports(u, u);
    o := u.q;
}
