// S016: the plain call of a mut formal in a hardware arm.
// TOP M()
fn inc(mut a: UInt[8]) -> UInt[8] {
    a = a +% 1;
    return a;
}
module M() {
    input c: Bool;
    input x: UInt[8];
    output o: UInt[8];
    let mut q = x;
    // expected-error S016 @+2
    // expected-message: a hardware arm cannot change `q`, a binding from before the arm; change `q` before the `if` or `match`, and use the result in the arm
    o := if (c) { inc(q) } else { 0 };
}
