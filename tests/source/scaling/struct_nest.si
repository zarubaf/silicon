// T4 of the work-counter tests of `@Struct` (issue #345). A generated record type nests N levels: each level has one
// field of the level below. The module builds the same nest twice and compares the two types N times. The two nests
// are one entry in the table, so a compare takes one step. A compare of the terms instead of the entry numbers makes
// work in the depth for each compare, and the work escapes the bound.
// SCALE struct_nest 8 16 32 64 128
// TOP M()
module M() domains() {
    input x: UInt[8];
    output o: UInt[8];
    let a = NEST{@Struct([FieldInfo("a", |Bool|)])};
    let b = NEST{@Struct([FieldInfo("a", |Bool|)])};
// REPEAT i {N}
    static_assert(a == b, "nest {i}");
// END
    o := x;
}
