// T6 of the work-counter tests of `@field` (issue #344). An array nested N levels holds an input, and N assignments
// `@field(...@field(a, 0)..., 0) = x` of depth N change its leaf. N calls pass the same place as a `mut` actual. The
// build pays its fuel in N^2 once, so the places share it. A walk along the path gives work in `O(N)` for a place; a
// walk from the root at each step gives `O(N^2)` for a place.
// SCALE field_place_nest 16 32 64 128 256
// TOP M()
fn bump(mut v: UInt[8]) -> UInt[8] {
    v = v +% 1;
    return v;
}
module M() {
    input x: UInt[8];
    output o: UInt[8];
    let mut a = NEST{[|x|]};
// REPEAT i {N}
    NEST{@field(|a|, 0)} = x;
// END
// REPEAT i {N}
    let n{i} = bump(NEST{@field(|a|, 0)});
// END
    o := x;
}
