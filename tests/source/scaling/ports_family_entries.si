// T3 of the work-counter tests of `@ports` (issue #346). A child has N entries of one family whose name has N bytes. The entries
// share one symbol and differ in the key, so the order compares two keys below 2^32 and no text. A compare of the text
// when the symbols are equal makes N more work for each compare, and the work escapes the bound.
// SCALE ports_family_entries 16 32 64 128 256
// TOP M()
module C() {
    comptime for i in 0..{N} {
        input NEST{a|req|}[i]: UInt[8];
    }
}
module M() {
    input x: UInt[8];
    output o: UInt[8];
    instance u = C();
    comptime for i in 0..{N} {
        u.NEST{a|req|}[i] := x;
    }
    let ps = @ports(u);
    o := x;
}
