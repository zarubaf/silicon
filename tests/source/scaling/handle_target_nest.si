// Pins a `:=` target walk that restarts from the root at each step (issue #278). `a[z()]...[z()][i] := x` selects
// register i of an array of N registers through N nested arrays, and each index of the nest is a call. N such targets
// share one array. A walk along the path gives work in `O(N)` for a target; a walk from the root at each step gives
// `O(N^2)` for a target. The build of the nested array pays its own fuel once, so only N targets show the walk.
// SCALE handle_target_nest 16 32 64 128 256
// TOP M()
fn z() -> Nat {
    return 0;
}
module M() {
    input x: UInt[8];
    output o: Bool;
// REPEAT i {N}
    reg r{i}: UInt[8] = 0;
// END
    let rs = [
// REPEAT i {N}
        r{i},
// END
    ];
    let a = NEST{[|rs|]};
// REPEAT i {N}
    NEST{|a|[z()]}[{i}] := x;
// END
    o := true;
}
