// The repro of the charge of a parameter argument (issue #266). A struct has N parameters of an
// array of 256 elements, and each argument is the same element of `a`. Each argument charges
// its size right after its typed use, before it copies into the frame, so a run that stops
// at the charge copies at most the units that it paid.
// SCALE struct_argument 4 8 16 32 64
// TOP M()
struct P(
// REPEAT i {N}
    comptime x{i}: [Nat; 256],
// END
) {
    v: Bool,
}
const X: [Nat; 256] = [
// REPEAT i 256
    0,
// END
];
module M() domains() {
    output o: Bool;
    let a = [X];
    type S = P[
// REPEAT i {N}
        a[0],
// END
    ];
    o := true;
}
