// Pins a query that walks from the root at each step. An array nested N levels holds a number. The build pays its fuel
// in N^2 once, so N queries of `[0]...[0]` of depth N share it. A walk along the path gives work in `O(N)` for a query;
// a walk from the root at each step gives `O(N^2)` for a query.
// SCALE typeof_place_nest 16 32 64 128 256
// TOP M()
module M() {
    input x: UInt[8];
    output o: UInt[8];
    let a = NEST{[|0|]};
// REPEAT i {N}
    let t{i} = @TypeOf(NEST{|a|[0]});
// END
    o := x;
}
