// A hardware `match` with N literal arms on a scrutinee of 64 * N bits. Each select makes the key
// literal of the scrutinee width, so the work is arms times words and the charge of the key
// pays for it (issue #272).
// SCALE select_arms 4 8 16 32 64
// TOP M()
module M() domains() {
    input x: UInt[64 * {N}];
    input y: UInt[8];
    output o: UInt[8];
    o := match (x) {
// REPEAT i {N}
        {i} => y +% {i},
// END
        _ => y,
    };
}
