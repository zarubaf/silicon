// The repro of the select audit of the hardware `match` (issue #272). The scrutinee has 64 * N
// bits, and the N literal arms and the arm `_` have no result leaf. Only the selects are left, so
// the charge of each select key pays for the key constant of 64 * N bits. Arms times words is
// the work.
// SCALE select_arms 4 8 16 32 64
// TOP M()
module M() domains() {
    input x: UInt[64 * {N}];
    match (x) {
// REPEAT i {N}
        {i} => (),
// END
        _ => (),
    };
}
