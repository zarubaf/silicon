// A constant table and a constant tuple, read by a static index in a comptime for. The
// weights fold into the shifts of one sum, and the tuple gives the width and the seed.
// TOP Table()
const WEIGHTS: [Nat; 4] = [1, 3, 5, 7];
const CONFIG: (Nat, Bool) = (8, true);
module Table() {
    input d: UInt[8];
    output y: UInt[8];
    reg acc: UInt[8] = 0;
    let mut sum = d;
    comptime for i in 0..len(WEIGHTS) {
        sum = sum +% (d << WEIGHTS[i]);
    }
    comptime if (CONFIG.1) {
        acc := acc ^ sum;
    } else {
        acc := sum;
    }
    y := acc;
}
