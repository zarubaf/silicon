// Four memories in two modules. The top holds a memory of five array words, a depth that is not a power of 2,
// and a memory of four 3-bit words, whose write enable depends on the data. A child holds a memory of one
// 3-bit word, the depth 1. Every port has a non-constant enable (#20). The child remembers the XOR of the two
// lanes of the last written word, and the top outputs the responses of all three memories.
// TOP Top()
module Flag() {
    input a: UInt[1];
    input d: UInt[3];
    input we: Bool;
    input re: Bool;
    output seen: Bool;
    mem flag: [UInt[3]; 1];
    let r = flag.read_port(a, re);
    flag.write_port(a, d, we);
    seen := r.valid && r.data != 0;
}
module Top() {
    input ra: UInt[3];
    input re: Bool;
    input wa: UInt[3];
    input we: Bool;
    input wd: [UInt[3]; 2];
    input fa: UInt[1];
    input ha: UInt[2];
    output h: UInt[3];
    output q: [UInt[3]; 2];
    output valid: Bool;
    output seen: Bool;
    mem read: [[UInt[3]; 2]; 5];
    let r = read.read_port(ra, re);
    read.write_port(wa, wd, we);
    mem hist: [UInt[3]; 4];
    let hr = hist.read_port(ha, re || we);
    hist.write_port(ha, wd[0] ^ wd[1], we && wd[0] != wd[1]);
    h := if (hr.valid) { hr.data } else { UInt[3]() };
    instance f = Flag();
    f.a := fa;
    f.d := wd[0] ^ wd[1];
    f.we := we;
    f.re := re;
    q := r.data;
    valid := r.valid;
    seen := f.seen;
}
