// The block of a memory with a power-of-2 depth: the memory, the two response registers, the
// request lets, and the next and write nodes. The compare for `valid` is the constant 1.
// TOP M()
// CHECK: (reg m$0rdata (bits 8) clock$0clk (reset sync clock$0rst (const 8 0)))
// CHECK-NEXT: (reg m$0rvalid (bits 1) clock$0clk (reset sync clock$0rst (const 1 0)))
// CHECK-NEXT: (mem m (bits 8) 4 clock$0clk)
// CHECK-NEXT: (let m$0raddr (bits 2) ra)
// CHECK-NEXT: (let m$0ren (bits 1) re)
// CHECK-NEXT: (let r$data (bits 8) (extract m$0rdata 0 8))
// CHECK-NEXT: (let r$valid (bits 1) m$0rvalid)
// CHECK-NEXT: (next m$0rdata (mux m$0ren (read m m$0raddr) m$0rdata))
// CHECK-NEXT: (next m$0rvalid (and m$0ren (const 1 1)))
// CHECK-NEXT: (write m 0 wa wd (and we (xor clock$0rst (const 1 1))))
// CHECK-NEXT: (assign q r$data)
// CHECK-NEXT: (assign v r$valid)))
module M() {
    input ra: UInt[2];
    input re: Bool;
    input wa: UInt[2];
    input we: Bool;
    input wd: UInt[8];
    output q: UInt[8];
    output v: Bool;
    mem m: [UInt[8]; 4];
    let r = m.read_port(ra, re);
    m.write_port(wa, wd, we);
    q := r.data;
    v := r.valid;
}
