// A list and a string decide two widths. Receiver calls fold them at elaboration time, so the
// design holds only the widths: both inputs and the output have 6 bits.
// TOP M()
// CHECK: (input a (bits 6))
// CHECK-NEXT: (input b (bits 6))
// CHECK-NEXT: (output y (bits 6))
// CHECK: (assign y (add a b))
comptime fn width() -> Nat {
    let mut xs = list(Nat);
    xs.push(2);
    xs.push(4);
    xs.push(xs.len());
    return xs.pop() + xs.pop() + xs.len() - 1;
}
module M() domains() {
    input a: UInt[width()];
    input b: UInt[("abc" + 123.str()).len()];
    output y: UInt[6];
    y := a +% b;
}
