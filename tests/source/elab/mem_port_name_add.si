// A memory named like a core keyword takes the field `0k`: `add$0k`. Its role names stay plain.
// TOP M()
// CHECK: (reg add$0rdata (bits 8) clock$0clk (reset sync clock$0rst (const 8 0)))
// CHECK-NEXT: (reg add$0rvalid (bits 1) clock$0clk (reset sync clock$0rst (const 1 0)))
// CHECK-NEXT: (mem add$0k (bits 8) 4 clock$0clk)
// CHECK-NEXT: (let add$0raddr (bits 2) a)
// CHECK-NEXT: (let add$0ren (bits 1) e)
// CHECK-NEXT: (let r$data (bits 8) (extract add$0rdata 0 8))
// CHECK-NEXT: (let r$valid (bits 1) add$0rvalid)
// CHECK-NEXT: (next add$0rdata (mux add$0ren (read add$0k add$0raddr) add$0rdata))
// CHECK-NEXT: (next add$0rvalid (and add$0ren (const 1 1)))
// CHECK-NEXT: (write add$0k 0 a d (and e (xor clock$0rst (const 1 1))))
// CHECK-NEXT: (assign q r$data)))
module M() {
    input a: UInt[2];
    input e: Bool;
    input d: UInt[8];
    output q: UInt[8];
    mem add: [UInt[8]; 4];
    let r = add.read_port(a, e);
    add.write_port(a, d, e);
    q := r.data;
}
