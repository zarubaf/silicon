// The write data packs the leaves of the word with the first leaf in the least significant bits:
// the concat has the last leaf first.
// TOP M()
// CHECK: (reg m$0rdata (bits 8) clock$0clk (reset sync clock$0rst (const 8 0)))
// CHECK-NEXT: (reg m$0rvalid (bits 1) clock$0clk (reset sync clock$0rst (const 1 0)))
// CHECK-NEXT: (mem m (bits 8) 4 clock$0clk)
// CHECK-NEXT: (let m$0raddr (bits 2) a)
// CHECK-NEXT: (let m$0ren (bits 1) e)
// CHECK-NEXT: (let r$data$x (bits 3) (extract m$0rdata 0 3))
// CHECK-NEXT: (let r$data$y (bits 1) (extract m$0rdata 3 1))
// CHECK-NEXT: (let r$data$z (bits 4) (extract m$0rdata 4 4))
// CHECK-NEXT: (let r$valid (bits 1) m$0rvalid)
// CHECK-NEXT: (next m$0rdata (mux m$0ren (read m m$0raddr) m$0rdata))
// CHECK-NEXT: (next m$0rvalid (and m$0ren (const 1 1)))
// CHECK-NEXT: (write m 0 a (concat z (concat y x)) (and e (xor clock$0rst (const 1 1))))
// CHECK-NEXT: (assign q$x r$data$x)
// CHECK-NEXT: (assign q$y r$data$y)
// CHECK-NEXT: (assign q$z r$data$z)))
struct W {
    x: UInt[3],
    y: Bool,
    z: UInt[4],
}
module M() {
    input a: UInt[2];
    input e: Bool;
    input x: UInt[3];
    input y: Bool;
    input z: UInt[4];
    output q: W;
    mem m: [W; 4];
    let r = m.read_port(a, e);
    m.write_port(a, W(x, y, z), e);
    q := r.data;
}
