; A 1000-bit add is modulo 2^1000; a zero-extended 1001-bit add keeps the
; carry (spec 4.1). The values are decimal of any size (spec 6.4.3).
(design top
  (module top
    (input a (bits 1000))
    (input b (bits 1000))
    (output s (bits 1000))
    (output w (bits 1001))
    (assign s (add a b))
    (assign w (add (concat (const 1 0) a) (concat (const 1 0) b)))))
; a = 2^1000 - 1, b = 1: s = 0, w = 2^1000
; STEP in=(a  b 1) out=(s 0 w )
; a = b = 2^999: s = 0, w = 2^1000
; STEP in=(a  b ) out=(s 0 w )
; a = 2^64 - 1, b = 1: the carry crosses bit 64
; STEP in=(a 18446744073709551615 b 1) out=(s 18446744073709551616 w 18446744073709551616)
; a = b = 2^1000 - 1: s = 2^1000 - 2, w = 2^1001 - 2
; STEP in=(a  b ) out=(s  w )
; zero
; STEP in=(a 0 b 0) out=(s 0 w 0)
