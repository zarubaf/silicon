; Purpose: the ten comparison predicates of icmp.
(design top
  (module top
    (input a (bits 8))
    (input b (bits 8))
    (output ceq (bits 1))
    (output cne (bits 1))
    (output cult (bits 1))
    (output cule (bits 1))
    (output cugt (bits 1))
    (output cuge (bits 1))
    (output cslt (bits 1))
    (output csle (bits 1))
    (output csgt (bits 1))
    (output csge (bits 1))
    (assign ceq (icmp eq a b))
    (assign cne (icmp ne a b))
    (assign cult (icmp ult a b))
    (assign cule (icmp ule a b))
    (assign cugt (icmp ugt a b))
    (assign cuge (icmp uge a b))
    (assign cslt (icmp slt a b))
    (assign csle (icmp sle a b))
    (assign csgt (icmp sgt a b))
    (assign csge (icmp sge a b))))
